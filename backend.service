[Unit]
Description=GlobalLink Backend Service
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/test/GlobalLink/backend
ExecStart=/usr/bin/python3 /home/admin/test/GlobalLink/backend/main.py
Restart=on-failure
RestartSec=5
Environment="PYTHONPATH=/home/admin/test/GlobalLink/backend"
EnvironmentFile=/home/admin/test/GlobalLink/.env

[Install]
WantedBy=multi-user.target