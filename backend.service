[Unit]
Description=GlobalLink Backend Service
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/test/GlobalLink/backend
ExecStart=/home/admin/test/GlobalLink/backend/venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment="PYTHONPATH=/home/admin/test/GlobalLink/backend"
EnvironmentFile=/home/admin/test/GlobalLink/backend/.env

[Install]
WantedBy=multi-user.target
