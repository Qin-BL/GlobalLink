[Unit]
Description=GlobalLink Backend Service
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/admin/test/GlobalLink/backend
ExecStart=/home/admin/test/GlobalLink/backend/venv/bin/python /home/admin/test/GlobalLink/backend/start_async.py
Restart=always
RestartSec=3
Environment="PATH=/home/admin/test/GlobalLink/backend/venv/bin"
EnvironmentFile=/home/admin/test/GlobalLink/backend/.env

[Install]
WantedBy=multi-user.target
