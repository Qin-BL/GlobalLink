# 数据库配置
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=globallink
POSTGRES_PORT=5432
SQLALCHEMY_DATABASE_URI=

# 数据库连接池配置
# DB_POOL_PRE_PING=True         # 连接前测试连接可用性
# DB_POOL_RECYCLE=300           # 连接回收时间（秒）
# DB_POOL_SIZE=5                # 连接池大小
# DB_POOL_MAX_OVERFLOW=10       # 连接池溢出最大值
# DB_POOL_TIMEOUT=30            # 连接池获取连接的超时时间（秒）

# 邮件服务配置
# 对于QQ邮箱，推荐使用SMTP服务器: smtp.qq.com
# 注意：使用QQ邮箱时，需要开启SMTP服务并获取授权码，而不是使用登录密码！
MAIL_SERVER=smtp.qq.com

# QQ邮箱推荐配置方案1（SSL/TLS加密）
# MAIL_PORT=465
# MAIL_USE_TLS=True

# QQ邮箱推荐配置方案2（STARTTLS加密） - 当前使用
MAIL_PORT=587
MAIL_USE_TLS=True

# 注意：MAIL_SSL_TLS会根据MAIL_PORT自动设置
# 当MAIL_PORT=465时，MAIL_SSL_TLS=True
# 当MAIL_PORT=587时，MAIL_SSL_TLS=False

# 发件人邮箱地址
# 请替换为实际的QQ邮箱地址
MAIL_USERNAME=2528756899@qq.com
# 重要：此处需要填写QQ邮箱的授权码，而不是登录密码！
# 获取方式：登录QQ邮箱 -> 设置 -> 账户 -> 生成授权码
MAIL_PASSWORD=ytkyflsnuutmdjhd
MAIL_FROM=2528756899@qq.com
# 发件人名称
MAIL_FROM_NAME=GlobalLink

# 邮件超时设置(秒)，已在代码中设置为10秒
# 如需自定义，请修改app/utils/email.py文件

# 邮件发送重试机制已在代码中实现
# 最大重试次数: 3次
# 重试间隔: 2秒
# 如需自定义，请修改app/utils/email.py文件中的send_email函数参数

# JWT配置
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8天

# CORS配置
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost"]

# 微信支付配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_API_KEY=your_wechat_api_key

# 推广配置
REFERRAL_RATE=0.5

# 会员价格
MONTHLY_MEMBERSHIP_PRICE=29.9
YEARLY_MEMBERSHIP_PRICE=299.0


# 前端密码加密验证配置
EXPECTED_DOMAIN=http://localhost:3080

# 错误通知配置
# 错误邮件通知接收邮箱列表，多个邮箱用逗号分隔
ERROR_NOTIFICATION_RECIPIENTS="15010993510@163.com,admin@example.com"
# 是否启用错误邮件通知功能 (true/false)
ERROR_NOTIFICATION_ENABLED=true

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL会根据上面的配置自动组装

# JWT配置补充
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# 允许的主机（安全配置）
ALLOWED_HOSTS=["localhost", "127.0.0.1", "*.globallink.com"]

# 应用基础配置
PROJECT_NAME=GlobalLink
VERSION=2.0.0
DEBUG=false

# 管理后台配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin